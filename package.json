{
  "name": "acidtest",
  "version": "1.1.0",
  "type": "module",
  "description": "Security scanner for MCP servers and AI agent skills. Scan before you install.",
  "bin": {
    "acidtest": "./dist/index.js"
  },
  "scripts": {
    "validate:patterns": "tsx src/validation/validate-patterns.ts",
    "prebuild": "npm run validate:patterns",
    "build": "tsc && mkdir -p dist/patterns dist/schemas && cp src/patterns/*.json dist/patterns/ && cp src/schemas/*.json dist/schemas/",
    "dev": "npm run build && node dist/index.js",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:corpus": "tsx src/test-corpus/validate-corpus.ts"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "security",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "agent-skills",
    "static-analysis",
    "prompt-injection",
    "supply-chain-security"
  ],
  "author": "Currently",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/currentlycurrently/acidtest"
  },
  "homepage": "https://acidtest.currently.website",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "chalk": "^6.0.0",
    "chokidar": "^5.0.0",
    "cli-table3": "^0.6.5",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "ora": "^9.3.0",
    "tree-sitter": "^0.21.1",
    "tree-sitter-python": "^0.21.0",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vitest/ui": "^4.1.11",
    "tsx": "^4.23.13",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
