{
  "category": "prompt-injection",
  "patterns": [
    {
      "id": "pi-001",
      "name": "instruction-override",
      "description": "Attempts to override agent instructions",
      "severity": "CRITICAL",
      "match": {
        "type": "regex",
        "value": "ignore\\s+(all\\s+)?(previous|prior|above)\\s+instructions",
        "flags": "i"
      },
      "layer": "markdown"
    },
    {
      "id": "pi-002",
      "name": "disregard-instructions",
      "description": "Attempts to disregard safety instructions",
      "severity": "CRITICAL",
      "match": {
        "type": "regex",
        "value": "disregard\\s+(your|all|previous|prior)\\s+(instructions|rules|guidelines)",
        "flags": "i"
      },
      "layer": "markdown"
    },
    {
      "id": "pi-003",
      "name": "forget-above",
      "description": "Attempts to erase previous context",
      "severity": "CRITICAL",
      "match": {
        "type": "regex",
        "value": "forget\\s+(everything|all)\\s+(above|previous|prior)",
        "flags": "i"
      },
      "layer": "markdown"
    },
    {
      "id": "pi-004",
      "name": "maintenance-mode",
      "description": "Claims system is in maintenance mode",
      "severity": "HIGH",
      "match": {
        "type": "regex",
        "value": "(you\\s+are\\s+now|now\\s+in)\\s+(maintenance|debug|admin)\\s+mode",
        "flags": "i"
      },
      "layer": "markdown"
    },
    {
      "id": "pi-005",
      "name": "system-override",
      "description": "Attempts system override",
      "severity": "HIGH",
      "match": {
        "type": "regex",
        "value": "system\\s+(override|reset|reboot)",
        "flags": "i"
      },
      "layer": "markdown"
    },
    {
      "id": "pi-006",
      "name": "new-instructions",
      "description": "Claims new instructions follow",
      "severity": "HIGH",
      "match": {
        "type": "regex",
        "value": "new\\s+instructions\\s+(follow|below)",
        "flags": "i"
      },
      "layer": "markdown"
    },
    {
      "id": "pi-007",
      "name": "act-as-root",
      "description": "Attempts to elevate privileges",
      "severity": "CRITICAL",
      "match": {
        "type": "regex",
        "value": "act\\s+as\\s+(root|admin|administrator|superuser)",
        "flags": "i"
      },
      "layer": "markdown"
    },
    {
      "id": "pi-008",
      "name": "jailbreak-claim",
      "description": "Claims agent has been jailbroken",
      "severity": "CRITICAL",
      "match": {
        "type": "regex",
        "value": "(you\\s+have\\s+been|you\\s+are\\s+now)\\s+jailbroken",
        "flags": "i"
      },
      "layer": "markdown"
    },
    {
      "id": "pi-009",
      "name": "zero-width-chars",
      "description": "Contains zero-width Unicode characters",
      "severity": "MEDIUM",
      "match": {
        "type": "regex",
        "value": "[\\u200B\\u200C\\u200D\\uFEFF]",
        "flags": "g"
      },
      "layer": "markdown"
    },
    {
      "id": "pi-010",
      "name": "html-comment-instructions",
      "description": "Instructions hidden in HTML comments",
      "severity": "MEDIUM",
      "match": {
        "type": "regex",
        "value": "<!--.*?(ignore|disregard|forget|override|new\\s+instruction).*?-->",
        "flags": "is"
      },
      "layer": "markdown"
    },
    {
      "id": "pi-011",
      "name": "fake-system-reminder",
      "description": "Fake system-reminder block impersonating agent-harness messages",
      "severity": "CRITICAL",
      "match": {
        "type": "regex",
        "value": "<\\s*/?\\s*system[-_ ]?reminder\\b",
        "flags": "i"
      },
      "layer": "markdown"
    },
    {
      "id": "pi-012",
      "name": "fake-conversation-block",
      "description": "Embedded fake tool-call or tool-result block impersonating the agent transcript",
      "severity": "CRITICAL",
      "match": {
        "type": "regex",
        "value": "<\\s*/?\\s*(function_(calls|results)|tool_(use|result|response)|antml:[a-z]+)\\b",
        "flags": "i"
      },
      "layer": "markdown"
    },
    {
      "id": "pi-013",
      "name": "embedded-tool-call-json",
      "description": "Embedded tool-call JSON attempting to spoof agent actions",
      "severity": "CRITICAL",
      "match": {
        "type": "regex",
        "value": "\"(tool_use|tool_calls|function_call)\"\\s*:",
        "flags": "i"
      },
      "layer": "markdown"
    },
    {
      "id": "pi-014",
      "name": "ai-direct-address",
      "description": "Text addressing the AI reading or reviewing the content directly",
      "severity": "HIGH",
      "match": {
        "type": "regex",
        "value": "(as|if\\s+you('re|\\s+are))\\s+(the|an?)\\s+(ai|llm|assistant|model|agent)\\s+(reviewing|reading|processing|analyzing|summarizing|scanning)",
        "flags": "i"
      },
      "layer": "markdown"
    },
    {
      "id": "pi-015",
      "name": "ai-audience-callout",
      "description": "Callout addressed to AI agents rather than human readers",
      "severity": "HIGH",
      "match": {
        "type": "regex",
        "value": "(attention|dear|note\\s+to)\\s+(all\\s+)?(ai|llm|claude|gpt|copilot|assistant|agent)s?\\b",
        "flags": "i"
      },
      "layer": "markdown"
    },
    {
      "id": "pi-016",
      "name": "claimed-official-provenance",
      "description": "Claims to be an official message from the AI vendor or the system",
      "severity": "HIGH",
      "match": {
        "type": "regex",
        "value": "(message|instructions?|directive|notice)\\s+from\\s+(anthropic|openai|google|the\\s+(system|platform|developers?))",
        "flags": "i"
      },
      "layer": "markdown"
    }
  ]
}
